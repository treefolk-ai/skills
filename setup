#!/bin/bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup [--host codex|grok] [--dry-run]
       setup --help

Install packages from skills/ into the shared user directory
discovered by Codex and Grok.

Options:
  --host HOST  Accept codex or grok for host-specific automation. Both activate
               the same shared directory. The default is codex for compatibility.
  --dry-run    Print the plan without changing the filesystem.
  --help, -h   Show this help message.

Install target precedence:
  1. TREEFOLK_SKILLS_DIR
  2. HOME/.agents/skills

Existing owned links under CODEX_HOME/skills or HOME/.codex/skills are retained
as legacy Codex compatibility links and updated for the skills/ source layout.
New links are created only in the shared target.
EOF
}

fail() {
  printf 'setup: %s\n' "$1" >&2
  exit 2
}

# Print PATH with its parent directory resolved physically. PATH itself need not
# exist. This keeps repository discovery independent of the caller's cwd.
physical_parent_path() {
  local input_path parent leaf physical_parent

  input_path=$1
  case "$input_path" in
    /*) ;;
    *) input_path="$(pwd -P)/$input_path" ;;
  esac

  parent=${input_path%/*}
  leaf=${input_path##*/}
  if [ -z "$parent" ]; then
    parent=/
  fi

  physical_parent=$(CDPATH= cd -P "$parent" && pwd)
  printf '%s/%s\n' "${physical_parent%/}" "$leaf"
}

repository_root() {
  local source_path command_path link_target source_parent

  source_path=${BASH_SOURCE[0]}
  case "$source_path" in
    */*) ;;
    *)
      command_path=$(command -v "$source_path") || return 1
      source_path=$command_path
      ;;
  esac

  source_path=$(physical_parent_path "$source_path")
  while [ -L "$source_path" ]; do
    link_target=$(readlink -n "$source_path" && printf '.') || return 1
    link_target=${link_target%.}
    case "$link_target" in
      /*) source_path=$link_target ;;
      *)
        source_parent=${source_path%/*}
        source_path="$source_parent/$link_target"
        ;;
    esac
    source_path=$(physical_parent_path "$source_path")
  done

  source_parent=${source_path%/*}
  CDPATH= cd -P "$source_parent" && pwd
}

resolve_target() {
  local selected

  if [ "${TREEFOLK_SKILLS_DIR+x}" = x ]; then
    [ -n "$TREEFOLK_SKILLS_DIR" ] || fail 'TREEFOLK_SKILLS_DIR is set but empty'
    selected=$TREEFOLK_SKILLS_DIR
  else
    [ "${HOME+x}" = x ] && [ -n "$HOME" ] || fail 'HOME is not set'
    selected="${HOME%/}/.agents/skills"
  fi

  case "$selected" in
    /*) ;;
    *) selected="$(pwd -P)/$selected" ;;
  esac

  while [ "$selected" != / ] && [ "${selected%/}" != "$selected" ]; do
    selected=${selected%/}
  done
  printf '%s\n' "$selected"
}

resolve_legacy_codex_target() {
  local selected

  if [ "${CODEX_HOME+x}" = x ]; then
    [ -n "$CODEX_HOME" ] || fail 'CODEX_HOME is set but empty'
    selected="${CODEX_HOME%/}/skills"
  else
    [ "${HOME+x}" = x ] && [ -n "$HOME" ] || fail 'HOME is not set'
    selected="${HOME%/}/.codex/skills"
  fi

  case "$selected" in
    /*) ;;
    *) selected="$(pwd -P)/$selected" ;;
  esac

  while [ "$selected" != / ] && [ "${selected%/}" != "$selected" ]; do
    selected=${selected%/}
  done
  printf '%s\n' "$selected"
}

physical_directory() {
  CDPATH= cd -P "$1" 2>/dev/null && pwd
}

link_resolves_to() {
  local candidate expected resolved

  candidate=$1
  expected=$2
  [ -L "$candidate" ] || return 1
  resolved=$(physical_directory "$candidate") || return 1
  [ "$resolved" = "$expected" ]
}

# Compare a symlink's target with an expected path without requiring the target
# itself to exist. This is used only for narrowly owned legacy links whose
# source directories disappeared after a public skill rename or layout move.
link_points_to_path() {
  local candidate expected raw_output raw_target

  candidate=$1
  expected=$2
  [ -L "$candidate" ] || return 1

  # Command substitution strips trailing newlines, which are valid symlink
  # target bytes. Suppress readlink's delimiter and append a sentinel so a
  # lookalike target ending in a newline can never compare equal.
  raw_output=$(readlink -n "$candidate" && printf '.') || return 1
  raw_target=${raw_output%.}

  # Historical setup versions created absolute links from the physical
  # repository root. Exact byte equality is therefore both sufficient proof
  # of ownership and safer than normalizing an arbitrary lookalike path.
  [ "$raw_target" = "$expected" ]
}

# Former package paths may have been repurposed after a layout move or rename.
# Only absent old sources and the exact historical absolute link are owned.
owned_old_package_link() {
  local candidate old_source
  candidate=$1
  old_source=$2
  { [ ! -e "$old_source" ] && [ ! -L "$old_source" ]; } || return 1
  link_points_to_path "$candidate" "$old_source"
}

owned_renamed_package_link() {
  local candidate old_source old_name
  candidate=$1
  old_source=$2
  old_name=${old_source##*/}
  # Either former layout may now contain user content or a new public package.
  { [ ! -e "$REPOSITORY_ROOT/$old_name" ] &&
    [ ! -L "$REPOSITORY_ROOT/$old_name" ] &&
    [ ! -e "$REPOSITORY_ROOT/skills/$old_name" ] &&
    [ ! -L "$REPOSITORY_ROOT/skills/$old_name" ]; } || return 1
  owned_old_package_link "$candidate" "$old_source"
}

host=codex
host_option_seen=0
dry_run=0

legacy_skill_migrations=(
  "commit-push push"
  "c-push push"
  "setup-repo repo"
  "s-repo repo"
  "code-craft build"
  "skills/code-craft build"
)

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      [ "$#" -ge 2 ] || fail '--host requires a value'
      [ "$host_option_seen" -eq 0 ] || fail '--host may be specified only once'
      host=$2
      host_option_seen=1
      shift 2
      ;;
    --host=*)
      [ "$host_option_seen" -eq 0 ] || fail '--host may be specified only once'
      host=${1#--host=}
      host_option_seen=1
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      ;;
  esac
done

case "$host" in
  codex|grok) ;;
  *) fail "unsupported host: $host (expected codex or grok)" ;;
esac

REPOSITORY_ROOT=$(repository_root) || fail 'could not resolve the repository root'
TARGET_DIR=$(resolve_target)
LEGACY_CODEX_TARGET_DIR=$(resolve_legacy_codex_target)

printf 'Repository: %s\n' "$REPOSITORY_ROOT"
printf 'Target: %s\n' "$TARGET_DIR"
printf 'Legacy Codex target: %s\n' "$LEGACY_CODEX_TARGET_DIR"
printf 'Host: %s\n' "$host"
if [ "$dry_run" -eq 1 ]; then
  printf 'Mode: dry-run\n'
else
  printf 'Mode: install\n'
fi
printf 'Plan:\n'

planned_count=0
installed_count=0
skipped_count=0
conflict_count=0
skill_count=0
migration_count=0
migrated_count=0
legacy_destinations=()
legacy_old_sources=()
legacy_replacement_names=()
relocation_destinations=()
relocation_old_sources=()
relocation_new_sources=()

if { [ -L "$TARGET_DIR" ] && [ ! -d "$TARGET_DIR" ]; } ||
   { [ -e "$TARGET_DIR" ] && [ ! -d "$TARGET_DIR" ]; }; then
  printf '  conflict  target is not a directory: %s\n' "$TARGET_DIR"
  conflict_count=$((conflict_count + 1))
else
  shopt -s nullglob dotglob
  for skill_file in "$REPOSITORY_ROOT"/skills/*/SKILL.md; do
    [ -f "$skill_file" ] || continue
    skill_dir=${skill_file%/SKILL.md}
    [ -d "$skill_dir" ] || continue

    skill_count=$((skill_count + 1))
    skill_name=${skill_dir##*/}
    skill_physical=$(physical_directory "$skill_dir")
    destination="$TARGET_DIR/$skill_name"

    if link_resolves_to "$destination" "$skill_physical"; then
      printf '  skip      %s (already linked)\n' "$skill_name"
      skipped_count=$((skipped_count + 1))
    elif owned_old_package_link "$destination" "$REPOSITORY_ROOT/$skill_name"; then
      printf '  migrate   %s (source layout at %s)\n' "$skill_name" "$destination"
      relocation_destinations[${#relocation_destinations[@]}]=$destination
      relocation_old_sources[${#relocation_old_sources[@]}]="$REPOSITORY_ROOT/$skill_name"
      relocation_new_sources[${#relocation_new_sources[@]}]=$skill_dir
      migration_count=$((migration_count + 1))
    elif [ -L "$destination" ]; then
      printf '  conflict  %s (wrong symlink at %s)\n' "$skill_name" "$destination"
      conflict_count=$((conflict_count + 1))
    elif [ -e "$destination" ]; then
      if [ -d "$destination" ]; then
        printf '  conflict  %s (directory exists at %s)\n' "$skill_name" "$destination"
      else
        printf '  conflict  %s (non-symlink exists at %s)\n' "$skill_name" "$destination"
      fi
      conflict_count=$((conflict_count + 1))
    else
      printf '  install   %s -> %s\n' "$skill_name" "$destination"
      planned_count=$((planned_count + 1))
    fi
  done
fi

# Legacy Codex directories are compatibility locations, never new install
# targets. Ignore unrelated entries and only update an existing owned link.
# Compare physical directories too: two configured paths can name one target.
legacy_is_shared=0
if [ "$LEGACY_CODEX_TARGET_DIR" = "$TARGET_DIR" ]; then
  legacy_is_shared=1
elif [ -d "$LEGACY_CODEX_TARGET_DIR" ] && [ -d "$TARGET_DIR" ] &&
     [ "$(physical_directory "$LEGACY_CODEX_TARGET_DIR")" = "$(physical_directory "$TARGET_DIR")" ]; then
  legacy_is_shared=1
fi
if [ "$legacy_is_shared" -eq 0 ] && [ -d "$LEGACY_CODEX_TARGET_DIR" ]; then
  for skill_file in "$REPOSITORY_ROOT"/skills/*/SKILL.md; do
    [ -f "$skill_file" ] || continue
    skill_dir=${skill_file%/SKILL.md}
    [ -d "$skill_dir" ] || continue
    skill_name=${skill_dir##*/}
    destination="$LEGACY_CODEX_TARGET_DIR/$skill_name"
    if owned_old_package_link "$destination" "$REPOSITORY_ROOT/$skill_name"; then
      printf '  migrate   %s (source layout at %s)\n' "$skill_name" "$destination"
      relocation_destinations[${#relocation_destinations[@]}]=$destination
      relocation_old_sources[${#relocation_old_sources[@]}]="$REPOSITORY_ROOT/$skill_name"
      relocation_new_sources[${#relocation_new_sources[@]}]=$skill_dir
      migration_count=$((migration_count + 1))
    fi
  done
fi

# Historical names are removed from either existing target only after the
# replacement is active in the shared target. The table records old source
# paths relative to this checkout, so both former layouts can be recognized.
rename_targets=("$TARGET_DIR")
if [ "$legacy_is_shared" -eq 0 ] && [ -d "$LEGACY_CODEX_TARGET_DIR" ]; then
  rename_targets[${#rename_targets[@]}]=$LEGACY_CODEX_TARGET_DIR
fi
for rename_target in "${rename_targets[@]}"; do
  for legacy_migration in "${legacy_skill_migrations[@]}"; do
    legacy_path=${legacy_migration%% *}
    legacy_name=${legacy_path##*/}
    replacement_name=${legacy_migration#* }
    legacy_source="$REPOSITORY_ROOT/$legacy_path"
    legacy_destination="$rename_target/$legacy_name"
    [ -f "$REPOSITORY_ROOT/skills/$replacement_name/SKILL.md" ] || continue
    if owned_renamed_package_link "$legacy_destination" "$legacy_source"; then
      printf '  migrate   %s -> %s (remove owned legacy link at %s)\n' \
        "$legacy_name" "$replacement_name" "$legacy_destination"
      legacy_destinations[${#legacy_destinations[@]}]=$legacy_destination
      legacy_old_sources[${#legacy_old_sources[@]}]=$legacy_source
      legacy_replacement_names[${#legacy_replacement_names[@]}]=$replacement_name
      migration_count=$((migration_count + 1))
    fi
  done
done

if [ "$skill_count" -eq 0 ] && [ "$conflict_count" -eq 0 ]; then
  printf '  (no skills/ packages found)\n'
fi

if [ "$conflict_count" -gt 0 ]; then
  printf 'Installed: %d\n' "$installed_count"
  printf 'Migrated: %d\n' "$migrated_count"
  printf 'Skipped: %d\n' "$skipped_count"
  printf 'Conflicts: %d\n' "$conflict_count"
  exit 1
fi

if [ "$dry_run" -eq 0 ] && { [ "$planned_count" -gt 0 ] || [ "$migration_count" -gt 0 ]; }; then
  mkdir -p "$TARGET_DIR"

  for skill_file in "$REPOSITORY_ROOT"/skills/*/SKILL.md; do
    [ -f "$skill_file" ] || continue
    skill_dir=${skill_file%/SKILL.md}
    [ -d "$skill_dir" ] || continue

    skill_name=${skill_dir##*/}
    skill_physical=$(physical_directory "$skill_dir")
    destination="$TARGET_DIR/$skill_name"

    if link_resolves_to "$destination" "$skill_physical" ||
       owned_old_package_link "$destination" "$REPOSITORY_ROOT/$skill_name"; then
      continue
    fi
    if [ -L "$destination" ] || [ -e "$destination" ]; then
      printf 'setup: destination changed after planning: %s\n' "$destination" >&2
      conflict_count=$((conflict_count + 1))
      break
    fi

    if ln -s "$skill_dir" "$destination"; then
      if link_resolves_to "$destination" "$skill_physical"; then
        installed_count=$((installed_count + 1))
      else
        printf 'setup: could not verify symlink: %s\n' "$destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
    else
      printf 'setup: could not create symlink: %s\n' "$destination" >&2
      conflict_count=$((conflict_count + 1))
      break
    fi
  done

  if [ "$conflict_count" -eq 0 ]; then
    relocation_index=0
    while [ "$relocation_index" -lt "${#relocation_destinations[@]}" ]; do
      destination=${relocation_destinations[$relocation_index]}
      old_source=${relocation_old_sources[$relocation_index]}
      new_source=${relocation_new_sources[$relocation_index]}
      if ! owned_old_package_link "$destination" "$old_source"; then
        printf 'setup: source-layout link changed after planning: %s\n' "$destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
      if ! unlink "$destination"; then
        printf 'setup: could not unlink owned source-layout link: %s\n' "$destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
      if ! ln -s "$new_source" "$destination"; then
        # Restore the previous link only if no concurrent entry took its place.
        if [ ! -e "$destination" ] && [ ! -L "$destination" ]; then
          ln -s "$old_source" "$destination" || true
        fi
        printf 'setup: could not update source-layout link: %s\n' "$destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
      if ! link_resolves_to "$destination" "$(physical_directory "$new_source")"; then
        printf 'setup: could not verify source-layout link: %s\n' "$destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
      migrated_count=$((migrated_count + 1))
      relocation_index=$((relocation_index + 1))
    done
  fi

  if [ "$conflict_count" -eq 0 ]; then
    legacy_index=0
    while [ "$legacy_index" -lt "${#legacy_destinations[@]}" ]; do
      legacy_destination=${legacy_destinations[$legacy_index]}
      legacy_source=${legacy_old_sources[$legacy_index]}
      replacement_name=${legacy_replacement_names[$legacy_index]}
      replacement_source="$REPOSITORY_ROOT/skills/$replacement_name"
      if ! [ -f "$replacement_source/SKILL.md" ] ||
         ! link_resolves_to "$TARGET_DIR/$replacement_name" "$(physical_directory "$replacement_source")"; then
        printf 'setup: replacement is not active; preserving legacy link: %s\n' "$legacy_destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi

      if owned_renamed_package_link "$legacy_destination" "$legacy_source"; then
        if unlink "$legacy_destination" && [ ! -e "$legacy_destination" ] && [ ! -L "$legacy_destination" ]; then
          migrated_count=$((migrated_count + 1))
        else
          printf 'setup: could not remove owned legacy link: %s\n' "$legacy_destination" >&2
          conflict_count=$((conflict_count + 1))
          break
        fi
      elif [ -L "$legacy_destination" ] || [ -e "$legacy_destination" ]; then
        printf 'setup: legacy link changed after planning: %s\n' "$legacy_destination" >&2
        conflict_count=$((conflict_count + 1))
        break
      fi
      legacy_index=$((legacy_index + 1))
    done
  fi
fi

printf 'Installed: %d\n' "$installed_count"
printf 'Migrated: %d\n' "$migrated_count"
printf 'Skipped: %d\n' "$skipped_count"
printf 'Conflicts: %d\n' "$conflict_count"

[ "$conflict_count" -eq 0 ]
